{
  "name": "viet-dynamic-api",
  "version": "1.0.0",
  "description": "Đây là hệ thống Back-end cung cấp RESTful API cho nền tảng E-learning **Viet Dynamic**. Hệ thống đảm nhiệm việc quản lý dữ liệu người dùng, tiến trình học tập, bảo mật (Authentication) và tích hợp cổng thanh toán (Payment Gateway).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library tsx watch src/server.ts",
    "clean": "rimraf dist",
    "build": "pnpm run clean && npx prisma generate && tsc && tsc-alias",
    "start": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "generate": "plop",
    "postinstall": "npx prisma generate",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns='.*\\.e2e\\.spec\\.ts$' --forceExit",
    "test:unit:watch": "jest --watch --testPathIgnorePatterns='.*\\.e2e\\.spec\\.ts$'",
    "test:db:setup": "dotenv -e .env.test -- npx prisma db push --accept-data-loss && dotenv -e .env.test -- npx tsx prisma/seed.ts",
    "test:e2e": "npm run test:db:setup && dotenv -e .env.test -- jest --testMatch='**/*.e2e.spec.ts' --runInBand --detectOpenHandles --forceExit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viet-dynamic/viet-dynamic-api.git"
  },
  "keywords": [
    "e-learning",
    "vnpay",
    "momo",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/viet-dynamic/viet-dynamic-api/issues"
  },
  "homepage": "https://github.com/viet-dynamic/viet-dynamic-api#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.1",
    "ms": "^2.1.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "plop": "^4.0.5",
    "prettier": "^3.8.2",
    "prisma": "^7.7.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "overrides": {
    "axios": "1.14.0"
  }
}
